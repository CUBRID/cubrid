# Generated Linux dependency package. No download or build rules.
set(CubridThirdParty_IDENTITY "@THIRDPARTY_IDENTITY@")
get_filename_component(prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
foreach(header expat.h histedit.h editline/readline.h lz4.h openssl/ssl.h sql.h
    sqltypes.h sqlext.h sqlucode.h unixodbc.h rapidjson/document.h re2/re2.h
    oneapi/tbb.h catch2/catch.hpp)
  if(NOT EXISTS "${prefix}/include/${header}")
    message(FATAL_ERROR "Incomplete third-party prefix: include/${header}")
  endif()
endforeach()
set(LIBUNIXODBC_SOURCE_DIR "${prefix}/sources/unixODBC")
foreach(runtime_file lib/libodbc.so.2 licenses/libodbc_license.txt
    sources/unixODBC/@THIRDPARTY_UNIXODBC_ARCHIVE@ sources/unixODBC/README.txt)
  if(NOT EXISTS "${prefix}/${runtime_file}")
    message(FATAL_ERROR "Incomplete third-party prefix: ${runtime_file}")
  endif()
endforeach()
set(CUBRID_3RDPARTY_EXPORTS EP_TARGETS EP_INCLUDES EP_LIBS TBB_TARGETS TBB_INCLUDES TBB_LIBS)
list(APPEND CUBRID_3RDPARTY_EXPORTS LIBUNIXODBC_SOURCE_DIR)
set(EP_TARGETS "")
set(EP_INCLUDES "")
set(EP_LIBS "")
set(TBB_TARGETS "")
set(TBB_INCLUDES "")
set(TBB_LIBS "")

macro(thirdparty_dependency variable name kind filename)
  set(${variable}_TARGET "CubridThirdParty::${name}")
  set(${variable}_INCLUDES "${prefix}/include")
  set(${variable}_LIBS "")
  if(NOT "${kind}" STREQUAL "INTERFACE")
    set(${variable}_LIBS "${prefix}/lib/${filename}")
    if(NOT EXISTS "${${variable}_LIBS}")
      message(FATAL_ERROR "Incomplete third-party prefix: ${${variable}_LIBS}")
    endif()
  endif()
  if(NOT TARGET ${${variable}_TARGET})
    if("${kind}" STREQUAL "INTERFACE")
      add_library(${${variable}_TARGET} INTERFACE IMPORTED GLOBAL)
    else()
      add_library(${${variable}_TARGET} ${kind} IMPORTED GLOBAL)
      set_target_properties(${${variable}_TARGET} PROPERTIES
        IMPORTED_LOCATION "${${variable}_LIBS}")
    endif()
    set_target_properties(${${variable}_TARGET} PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${prefix}/include")
  endif()
  list(APPEND CUBRID_3RDPARTY_EXPORTS
    ${variable}_TARGET ${variable}_INCLUDES ${variable}_LIBS)
endmacro()

thirdparty_dependency(LIBEXPAT expat STATIC libexpat.a)
thirdparty_dependency(LIBEDIT edit STATIC libedit.a)
thirdparty_dependency(LZ4 lz4 STATIC liblz4.a)
thirdparty_dependency(LIBOPENSSL ssl STATIC libssl.a)
thirdparty_dependency(LIBCRYPTO crypto STATIC libcrypto.a)
thirdparty_dependency(LIBUNIXODBC odbc SHARED libodbc.so)
thirdparty_dependency(RAPIDJSON rapidjson INTERFACE "")
thirdparty_dependency(RE2 re2 STATIC libre2.a)
thirdparty_dependency(LIBTBB tbb STATIC libtbb.a)
thirdparty_dependency(CATCH2 catch2 INTERFACE "")
set(LIBOPENSSL_LIBS ${LIBOPENSSL_LIBS} ${LIBCRYPTO_LIBS})
set_target_properties(${LIBOPENSSL_TARGET} PROPERTIES
  INTERFACE_LINK_LIBRARIES "${LIBCRYPTO_TARGET}")
foreach(variable LIBEXPAT LIBEDIT LZ4 LIBOPENSSL RAPIDJSON RE2)
  list(APPEND EP_TARGETS ${${variable}_TARGET})
  list(APPEND EP_LIBS ${${variable}_TARGET})
endforeach()
set(EP_INCLUDES "${prefix}/include")
set(TBB_TARGETS ${LIBTBB_TARGET})
set(LIBTBB_INCLUDES "${prefix}/include" "${prefix}/include/tbb"
  "${prefix}/include/oneapi" "${prefix}/include/oneapi/tbb"
  "${prefix}/include/oneapi/tbb/detail")
set_target_properties(${LIBTBB_TARGET} PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${LIBTBB_INCLUDES}")
set(TBB_INCLUDES ${LIBTBB_INCLUDES})
set(TBB_LIBS ${LIBTBB_TARGET})
message(STATUS "Using standalone third-party package: ${prefix}")
