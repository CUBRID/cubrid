include_guard(GLOBAL)

function(_cubrid_thirdparty_fail)
  string(JOIN "" message_text ${ARGV})
  message(FATAL_ERROR "CUBRID third-party contract: ${message_text}")
endfunction()

function(_cubrid_thirdparty_require_utf8 manifest_hex)
  string(LENGTH "${manifest_hex}" hex_length)
  set(hex_index 0)
  while(hex_index LESS hex_length)
    string(SUBSTRING "${manifest_hex}" ${hex_index} 2 byte_hex)
    math(EXPR byte_value "0x${byte_hex}")
    if(byte_value EQUAL 13)
      _cubrid_thirdparty_fail("manifest must use LF line endings")
    endif()
    if(byte_value LESS 128)
      set(continuation_count 0)
      set(second_min 128)
      set(second_max 191)
    elseif(byte_value GREATER_EQUAL 194 AND byte_value LESS_EQUAL 223)
      set(continuation_count 1)
      set(second_min 128)
      set(second_max 191)
    elseif(byte_value GREATER_EQUAL 224 AND byte_value LESS_EQUAL 239)
      set(continuation_count 2)
      if(byte_value EQUAL 224)
        set(second_min 160)
        set(second_max 191)
      elseif(byte_value EQUAL 237)
        set(second_min 128)
        set(second_max 159)
      else()
        set(second_min 128)
        set(second_max 191)
      endif()
    elseif(byte_value GREATER_EQUAL 240 AND byte_value LESS_EQUAL 244)
      set(continuation_count 3)
      if(byte_value EQUAL 240)
        set(second_min 144)
        set(second_max 191)
      elseif(byte_value EQUAL 244)
        set(second_min 128)
        set(second_max 143)
      else()
        set(second_min 128)
        set(second_max 191)
      endif()
    else()
      _cubrid_thirdparty_fail("manifest must contain valid UTF-8")
    endif()

    math(EXPR hex_index "${hex_index} + 2")
    if(continuation_count GREATER 0)
      math(EXPR required_hex_length "${hex_index} + (${continuation_count} * 2)")
      if(required_hex_length GREATER hex_length)
        _cubrid_thirdparty_fail("manifest must contain valid UTF-8")
      endif()
      foreach(continuation_index RANGE 1 ${continuation_count})
        string(SUBSTRING "${manifest_hex}" ${hex_index} 2 continuation_hex)
        math(EXPR continuation_value "0x${continuation_hex}")
        if(continuation_index EQUAL 1)
          if(continuation_value LESS second_min OR continuation_value GREATER second_max)
            _cubrid_thirdparty_fail("manifest must contain valid UTF-8")
          endif()
        elseif(continuation_value LESS 128 OR continuation_value GREATER 191)
          _cubrid_thirdparty_fail("manifest must contain valid UTF-8")
        endif()
        math(EXPR hex_index "${hex_index} + 2")
      endforeach()
    endif()
  endwhile()
endfunction()

function(_cubrid_thirdparty_quote_json input output_variable)
  set(escaped "${input}")
  string(REPLACE "\\" "\\\\" escaped "${escaped}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  string(REPLACE "\r" "\\r" escaped "${escaped}")
  string(REPLACE "\t" "\\t" escaped "${escaped}")
  set(${output_variable} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(_cubrid_thirdparty_render_json json depth output_variable)
  set(json_path ${ARGN})
  string(JSON node_type TYPE "${json}" ${json_path})
  if(node_type STREQUAL "OBJECT")
    string(JSON node_length LENGTH "${json}" ${json_path})
    if(node_length EQUAL 0)
      set(rendered "{}")
    else()
      math(EXPR child_depth "${depth} + 1")
      string(REPEAT "  " ${child_depth} child_indent)
      string(REPEAT "  " ${depth} current_indent)
      set(rendered "{\n")
      math(EXPR last_index "${node_length} - 1")
      foreach(member_index RANGE 0 ${last_index})
        string(JSON member_name MEMBER "${json}" ${json_path} ${member_index})
        _cubrid_thirdparty_quote_json("${member_name}" quoted_member_name)
        _cubrid_thirdparty_render_json("${json}" ${child_depth} child_value ${json_path} "${member_name}")
        string(APPEND rendered "${child_indent}${quoted_member_name}: ${child_value}")
        if(NOT member_index EQUAL last_index)
          string(APPEND rendered ",")
        endif()
        string(APPEND rendered "\n")
      endforeach()
      string(APPEND rendered "${current_indent}}")
    endif()
  elseif(node_type STREQUAL "ARRAY")
    string(JSON node_length LENGTH "${json}" ${json_path})
    if(node_length EQUAL 0)
      set(rendered "[]")
    else()
      math(EXPR child_depth "${depth} + 1")
      string(REPEAT "  " ${child_depth} child_indent)
      string(REPEAT "  " ${depth} current_indent)
      set(rendered "[\n")
      math(EXPR last_index "${node_length} - 1")
      foreach(array_index RANGE 0 ${last_index})
        _cubrid_thirdparty_render_json("${json}" ${child_depth} child_value ${json_path} ${array_index})
        string(APPEND rendered "${child_indent}${child_value}")
        if(NOT array_index EQUAL last_index)
          string(APPEND rendered ",")
        endif()
        string(APPEND rendered "\n")
      endforeach()
      string(APPEND rendered "${current_indent}]")
    endif()
  elseif(node_type STREQUAL "STRING")
    string(JSON node_value GET "${json}" ${json_path})
    _cubrid_thirdparty_quote_json("${node_value}" rendered)
  elseif(node_type STREQUAL "NULL")
    set(rendered "null")
  elseif(node_type STREQUAL "BOOLEAN")
    string(JSON node_value GET "${json}" ${json_path})
    string(TOLOWER "${node_value}" rendered)
  else()
    string(JSON rendered GET "${json}" ${json_path})
  endif()
  set(${output_variable} "${rendered}" PARENT_SCOPE)
endfunction()

function(_cubrid_thirdparty_require_keys json location expected_keys)
  set(json_path ${ARGN})
  string(JSON actual_type TYPE "${json}" ${json_path})
  if(NOT actual_type STREQUAL "OBJECT")
    _cubrid_thirdparty_fail("${location} must be an object")
  endif()
  string(JSON object_length LENGTH "${json}" ${json_path})
  set(actual_keys "")
  if(object_length GREATER 0)
    math(EXPR last_index "${object_length} - 1")
    foreach(member_index RANGE 0 ${last_index})
      string(JSON member_name MEMBER "${json}" ${json_path} ${member_index})
      list(APPEND actual_keys "${member_name}")
    endforeach()
  endif()
  list(SORT actual_keys)
  set(sorted_expected_keys ${expected_keys})
  list(SORT sorted_expected_keys)
  if(NOT "${actual_keys}" STREQUAL "${sorted_expected_keys}")
    _cubrid_thirdparty_fail(
      "unknown or missing keys at ${location}; expected [${sorted_expected_keys}], got [${actual_keys}]")
  endif()
endfunction()

function(_cubrid_thirdparty_require_type json location expected_type)
  set(json_path ${ARGN})
  string(JSON actual_type TYPE "${json}" ${json_path})
  if(NOT actual_type STREQUAL expected_type)
    string(TOLOWER "${expected_type}" readable_type)
    _cubrid_thirdparty_fail("${location} must be a ${readable_type}")
  endif()
endfunction()

function(_cubrid_thirdparty_require_sha256 value location)
  string(LENGTH "${value}" value_length)
  if(NOT value_length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
    _cubrid_thirdparty_fail("${location} must be 64 lowercase hexadecimal characters")
  endif()
endfunction()

function(_cubrid_thirdparty_require_relative_path value location)
  if(value STREQUAL "" OR IS_ABSOLUTE "${value}" OR value MATCHES "(^|/)\\.\\.(/|$)")
    _cubrid_thirdparty_fail("${location} must be a non-empty relative path without '..'")
  endif()
endfunction()

function(_cubrid_thirdparty_read_string_array json location output_variable require_sorted)
  set(json_path ${ARGN})
  _cubrid_thirdparty_require_type("${json}" "${location}" ARRAY ${json_path})
  string(JSON array_length LENGTH "${json}" ${json_path})
  set(values "")
  if(array_length GREATER 0)
    math(EXPR last_index "${array_length} - 1")
    foreach(array_index RANGE 0 ${last_index})
      _cubrid_thirdparty_require_type("${json}" "${location}[${array_index}]" STRING ${json_path} ${array_index})
      string(JSON array_value GET "${json}" ${json_path} ${array_index})
      list(APPEND values "${array_value}")
    endforeach()
  endif()
  if(require_sorted)
    set(sorted_values ${values})
    list(SORT sorted_values)
    if(NOT "${values}" STREQUAL "${sorted_values}")
      _cubrid_thirdparty_fail("${location} must be sorted")
    endif()
  endif()
  set(${output_variable} "${values}" PARENT_SCOPE)
endfunction()

function(_cubrid_thirdparty_validate_manifest json)
  _cubrid_thirdparty_require_keys(
    "${json}" "manifest root" "dependencies;platform;recipe_revision;schema")

  _cubrid_thirdparty_require_type("${json}" "schema" STRING schema)
  string(JSON schema GET "${json}" schema)
  if(NOT schema STREQUAL "cubrid-thirdparty-manifest-v1")
    _cubrid_thirdparty_fail("unsupported schema: ${schema}")
  endif()

  _cubrid_thirdparty_require_type("${json}" "recipe_revision" NUMBER recipe_revision)
  string(JSON recipe_revision GET "${json}" recipe_revision)
  if(NOT recipe_revision MATCHES "^[0-9]+$")
    _cubrid_thirdparty_fail("recipe_revision must be an integer")
  endif()

  _cubrid_thirdparty_require_keys("${json}" "platform" "architecture;os;variant" platform)
  foreach(platform_key IN ITEMS architecture os variant)
    _cubrid_thirdparty_require_type("${json}" "platform.${platform_key}" STRING platform ${platform_key})
  endforeach()
  string(JSON architecture GET "${json}" platform architecture)
  string(JSON operating_system GET "${json}" platform os)
  string(JSON platform_variant GET "${json}" platform variant)
  if(NOT architecture STREQUAL "x86_64" OR NOT operating_system STREQUAL "linux"
      OR NOT platform_variant STREQUAL "build_rl8.10-default")
    _cubrid_thirdparty_fail(
      "unsupported platform: os=${operating_system}, architecture=${architecture}, variant=${platform_variant}")
  endif()

  _cubrid_thirdparty_require_type("${json}" "dependencies" ARRAY dependencies)
  string(JSON dependency_count LENGTH "${json}" dependencies)
  if(NOT dependency_count EQUAL 8)
    _cubrid_thirdparty_fail("dependencies must contain exactly eight entries")
  endif()

  set(expected_names expat libedit lz4 openssl unixodbc rapidjson re2 onetbb)
  set(actual_names "")
  math(EXPR last_dependency "${dependency_count} - 1")
  foreach(dependency_index RANGE 0 ${last_dependency})
    set(dependency_path dependencies ${dependency_index})
    set(dependency_location "dependencies[${dependency_index}]")
    _cubrid_thirdparty_require_keys(
      "${json}" "${dependency_location}" "build;licenses;name;outputs;patches;source" ${dependency_path})
    _cubrid_thirdparty_require_type("${json}" "${dependency_location}.name" STRING ${dependency_path} name)
    string(JSON dependency_name GET "${json}" ${dependency_path} name)
    if(dependency_name IN_LIST actual_names)
      _cubrid_thirdparty_fail("duplicate dependency name: ${dependency_name}")
    endif()
    list(APPEND actual_names "${dependency_name}")

    _cubrid_thirdparty_require_keys(
      "${json}" "${dependency_location}.source" "sha256;url" ${dependency_path} source)
    foreach(source_key IN ITEMS sha256 url)
      _cubrid_thirdparty_require_type(
        "${json}" "${dependency_location}.source.${source_key}" STRING ${dependency_path} source ${source_key})
    endforeach()
    string(JSON source_sha256 GET "${json}" ${dependency_path} source sha256)
    string(JSON source_url GET "${json}" ${dependency_path} source url)
    _cubrid_thirdparty_require_sha256("${source_sha256}" "${dependency_location}.source.sha256")
    if(NOT source_url MATCHES "^https://")
      _cubrid_thirdparty_fail("${dependency_location}.source.url must use https")
    endif()

    _cubrid_thirdparty_require_keys(
      "${json}" "${dependency_location}.build"
      "build_arguments;configure_arguments;environment;install_arguments;recipe"
      ${dependency_path} build)
    foreach(argument_key IN ITEMS build_arguments configure_arguments install_arguments)
      _cubrid_thirdparty_read_string_array(
        "${json}" "${dependency_location}.build.${argument_key}" ignored FALSE
        ${dependency_path} build ${argument_key})
    endforeach()
    _cubrid_thirdparty_require_type(
      "${json}" "${dependency_location}.build.recipe" STRING ${dependency_path} build recipe)
    string(JSON recipe GET "${json}" ${dependency_path} build recipe)
    if(NOT recipe MATCHES "^(autoconf|cmake|make|openssl)$")
      _cubrid_thirdparty_fail("unsupported recipe: ${recipe}")
    endif()
    _cubrid_thirdparty_require_type(
      "${json}" "${dependency_location}.build.environment" OBJECT ${dependency_path} build environment)
    string(JSON environment_length LENGTH "${json}" ${dependency_path} build environment)
    if(environment_length GREATER 0)
      math(EXPR last_environment "${environment_length} - 1")
      foreach(environment_index RANGE 0 ${last_environment})
        string(JSON environment_name MEMBER "${json}" ${dependency_path} build environment ${environment_index})
        if(NOT environment_name MATCHES "^[A-Z][A-Z0-9_]*$")
          _cubrid_thirdparty_fail(
            "${dependency_location}.build.environment has malformed name: ${environment_name}")
        endif()
        _cubrid_thirdparty_require_type(
          "${json}" "${dependency_location}.build.environment.${environment_name}" STRING
          ${dependency_path} build environment ${environment_name})
      endforeach()
    endif()

    _cubrid_thirdparty_require_type("${json}" "${dependency_location}.patches" ARRAY ${dependency_path} patches)
    string(JSON patch_count LENGTH "${json}" ${dependency_path} patches)
    set(previous_patch_path "")
    if(patch_count GREATER 0)
      math(EXPR last_patch "${patch_count} - 1")
      foreach(patch_index RANGE 0 ${last_patch})
        _cubrid_thirdparty_require_keys(
          "${json}" "${dependency_location}.patches[${patch_index}]" "arguments;path;sha256"
          ${dependency_path} patches ${patch_index})
        _cubrid_thirdparty_read_string_array(
          "${json}" "${dependency_location}.patches[${patch_index}].arguments" ignored FALSE
          ${dependency_path} patches ${patch_index} arguments)
        foreach(patch_key IN ITEMS path sha256)
          _cubrid_thirdparty_require_type(
            "${json}" "${dependency_location}.patches[${patch_index}].${patch_key}" STRING
            ${dependency_path} patches ${patch_index} ${patch_key})
        endforeach()
        string(JSON patch_path GET "${json}" ${dependency_path} patches ${patch_index} path)
        string(JSON patch_sha256 GET "${json}" ${dependency_path} patches ${patch_index} sha256)
        _cubrid_thirdparty_require_relative_path(
          "${patch_path}" "${dependency_location}.patches[${patch_index}].path")
        _cubrid_thirdparty_require_sha256(
          "${patch_sha256}" "${dependency_location}.patches[${patch_index}].sha256")
        if(NOT previous_patch_path STREQUAL "" AND patch_path STRLESS previous_patch_path)
          _cubrid_thirdparty_fail("${dependency_location}.patches must be sorted by path")
        endif()
        set(previous_patch_path "${patch_path}")
      endforeach()
    endif()

    _cubrid_thirdparty_require_type("${json}" "${dependency_location}.licenses" ARRAY ${dependency_path} licenses)
    string(JSON license_count LENGTH "${json}" ${dependency_path} licenses)
    if(license_count EQUAL 0)
      _cubrid_thirdparty_fail("${dependency_location}.licenses must not be empty")
    endif()
    set(previous_license_destination "")
    math(EXPR last_license "${license_count} - 1")
    foreach(license_index RANGE 0 ${last_license})
      _cubrid_thirdparty_require_keys(
        "${json}" "${dependency_location}.licenses[${license_index}]" "destination;sha256;source"
        ${dependency_path} licenses ${license_index})
      foreach(license_key IN ITEMS destination sha256 source)
        _cubrid_thirdparty_require_type(
          "${json}" "${dependency_location}.licenses[${license_index}].${license_key}" STRING
          ${dependency_path} licenses ${license_index} ${license_key})
      endforeach()
      string(JSON license_destination GET "${json}" ${dependency_path} licenses ${license_index} destination)
      string(JSON license_source GET "${json}" ${dependency_path} licenses ${license_index} source)
      string(JSON license_sha256 GET "${json}" ${dependency_path} licenses ${license_index} sha256)
      _cubrid_thirdparty_require_relative_path(
        "${license_destination}" "${dependency_location}.licenses[${license_index}].destination")
      _cubrid_thirdparty_require_relative_path(
        "${license_source}" "${dependency_location}.licenses[${license_index}].source")
      _cubrid_thirdparty_require_sha256(
        "${license_sha256}" "${dependency_location}.licenses[${license_index}].sha256")
      if(NOT previous_license_destination STREQUAL ""
          AND license_destination STRLESS previous_license_destination)
        _cubrid_thirdparty_fail("${dependency_location}.licenses must be sorted by destination")
      endif()
      set(previous_license_destination "${license_destination}")
    endforeach()

    _cubrid_thirdparty_require_keys(
      "${json}" "${dependency_location}.outputs" "headers;libraries" ${dependency_path} outputs)
    _cubrid_thirdparty_read_string_array(
      "${json}" "${dependency_location}.outputs.headers" header_paths TRUE
      ${dependency_path} outputs headers)
    foreach(header_path IN LISTS header_paths)
      _cubrid_thirdparty_require_relative_path("${header_path}" "${dependency_location}.outputs.headers")
    endforeach()
    _cubrid_thirdparty_require_type(
      "${json}" "${dependency_location}.outputs.libraries" ARRAY ${dependency_path} outputs libraries)
    string(JSON library_count LENGTH "${json}" ${dependency_path} outputs libraries)
    if(library_count GREATER 0)
      math(EXPR last_library "${library_count} - 1")
      foreach(library_index RANGE 0 ${last_library})
        set(library_path ${dependency_path} outputs libraries ${library_index})
        set(library_location "${dependency_location}.outputs.libraries[${library_index}]")
        _cubrid_thirdparty_require_keys(
          "${json}" "${library_location}" "link_name;linkage;soname" ${library_path})
        foreach(library_key IN ITEMS link_name linkage)
          _cubrid_thirdparty_require_type(
            "${json}" "${library_location}.${library_key}" STRING ${library_path} ${library_key})
        endforeach()
        string(JSON link_name GET "${json}" ${library_path} link_name)
        string(JSON linkage GET "${json}" ${library_path} linkage)
        _cubrid_thirdparty_require_relative_path("${link_name}" "${library_location}.link_name")
        if(NOT linkage MATCHES "^(static|shared)$")
          _cubrid_thirdparty_fail("unsupported linkage: ${linkage}")
        endif()
        string(JSON soname_type TYPE "${json}" ${library_path} soname)
        if(linkage STREQUAL "static")
          if(NOT soname_type STREQUAL "NULL")
            _cubrid_thirdparty_fail("${library_location}.soname must be null for static linkage")
          endif()
        else()
          if(NOT soname_type STREQUAL "STRING")
            _cubrid_thirdparty_fail("${library_location}.soname must be a string for shared linkage")
          endif()
          string(JSON soname GET "${json}" ${library_path} soname)
          if(soname STREQUAL "")
            _cubrid_thirdparty_fail("${library_location}.soname must not be empty")
          endif()
        endif()
      endforeach()
    endif()
  endforeach()

  if(NOT "${actual_names}" STREQUAL "${expected_names}")
    _cubrid_thirdparty_fail(
      "dependencies must be in graph order [${expected_names}], got [${actual_names}]")
  endif()
endfunction()

function(cubrid_thirdparty_load_contract manifest_path)
  if(NOT IS_ABSOLUTE "${manifest_path}")
    get_filename_component(manifest_path "${manifest_path}" ABSOLUTE)
  endif()
  if(NOT EXISTS "${manifest_path}" OR IS_DIRECTORY "${manifest_path}")
    _cubrid_thirdparty_fail("manifest is not a regular file: ${manifest_path}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest_path}")
  file(SIZE "${manifest_path}" manifest_size)
  if(manifest_size EQUAL 0)
    _cubrid_thirdparty_fail("manifest is empty: ${manifest_path}")
  endif()
  file(READ "${manifest_path}" manifest_contents)
  file(READ "${manifest_path}" manifest_hex HEX)
  if(manifest_hex MATCHES "^efbbbf")
    _cubrid_thirdparty_fail("manifest must be UTF-8 without BOM")
  endif()
  _cubrid_thirdparty_require_utf8("${manifest_hex}")
  string(FIND "${manifest_hex}" "0d0a" crlf_position)
  if(NOT crlf_position EQUAL -1)
    _cubrid_thirdparty_fail("manifest must use LF line endings")
  endif()
  if(NOT manifest_hex MATCHES "0a$" OR manifest_hex MATCHES "0a0a$")
    _cubrid_thirdparty_fail("manifest must have exactly one final LF")
  endif()

  string(JSON root_type ERROR_VARIABLE json_error TYPE "${manifest_contents}")
  if(json_error)
    _cubrid_thirdparty_fail("manifest is not valid JSON: ${json_error}")
  endif()
  if(NOT root_type STREQUAL "OBJECT")
    _cubrid_thirdparty_fail("manifest root must be an object")
  endif()

  _cubrid_thirdparty_render_json("${manifest_contents}" 0 canonical_manifest)
  string(APPEND canonical_manifest "\n")
  if(NOT manifest_contents STREQUAL canonical_manifest)
    _cubrid_thirdparty_fail("third-party manifest is not canonical (UTF-8 without BOM, LF, two-space indentation, "
      "sorted object keys, exactly one final LF required)")
  endif()

  _cubrid_thirdparty_validate_manifest("${manifest_contents}")
  file(SHA256 "${manifest_path}" manifest_fingerprint)
  string(TOLOWER "${manifest_fingerprint}" manifest_fingerprint)
  string(JSON recipe_revision GET "${manifest_contents}" recipe_revision)
  string(JSON schema GET "${manifest_contents}" schema)

  string(JSON dependency_count LENGTH "${manifest_contents}" dependencies)
  string(JSON platform_architecture GET "${manifest_contents}" platform architecture)
  string(JSON platform_os GET "${manifest_contents}" platform os)
  string(JSON platform_variant GET "${manifest_contents}" platform variant)
  set(dependency_names "")
  math(EXPR last_dependency "${dependency_count} - 1")
  foreach(dependency_index RANGE 0 ${last_dependency})
    string(JSON dependency_name GET "${manifest_contents}" dependencies ${dependency_index} name)
    string(TOUPPER "${dependency_name}" dependency_variable_name)
    list(APPEND dependency_names "${dependency_name}")
    foreach(source_key IN ITEMS url sha256)
      string(JSON source_value GET "${manifest_contents}" dependencies ${dependency_index} source ${source_key})
      string(TOUPPER "${source_key}" source_variable_suffix)
      set("CUBRID_3RDPARTY_${dependency_variable_name}_SOURCE_${source_variable_suffix}"
        "${source_value}" PARENT_SCOPE)
    endforeach()
    string(JSON recipe GET "${manifest_contents}" dependencies ${dependency_index} build recipe)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_RECIPE" "${recipe}" PARENT_SCOPE)
    foreach(argument_key IN ITEMS build_arguments configure_arguments install_arguments)
      _cubrid_thirdparty_read_string_array(
        "${manifest_contents}" "dependencies[${dependency_index}].build.${argument_key}"
        argument_values FALSE dependencies ${dependency_index} build ${argument_key})
      string(TOUPPER "${argument_key}" argument_variable_suffix)
      set("CUBRID_3RDPARTY_${dependency_variable_name}_${argument_variable_suffix}"
        "${argument_values}" PARENT_SCOPE)
    endforeach()
    string(JSON environment_length LENGTH "${manifest_contents}" dependencies ${dependency_index} build environment)
    if(environment_length GREATER 0)
      math(EXPR last_environment "${environment_length} - 1")
      foreach(environment_index RANGE 0 ${last_environment})
        string(JSON environment_name MEMBER
          "${manifest_contents}" dependencies ${dependency_index} build environment ${environment_index})
        string(JSON environment_value GET
          "${manifest_contents}" dependencies ${dependency_index} build environment "${environment_name}")
        set("CUBRID_3RDPARTY_${dependency_variable_name}_ENV_${environment_name}"
          "${environment_value}" PARENT_SCOPE)
      endforeach()
    endif()

    _cubrid_thirdparty_read_string_array(
      "${manifest_contents}" "dependencies[${dependency_index}].outputs.headers"
      output_headers TRUE dependencies ${dependency_index} outputs headers)
    set(output_library_names "")
    set(output_library_linkages "")
    set(output_library_sonames "")
    string(JSON output_library_count LENGTH
      "${manifest_contents}" dependencies ${dependency_index} outputs libraries)
    if(output_library_count GREATER 0)
      math(EXPR last_output_library "${output_library_count} - 1")
      foreach(output_library_index RANGE 0 ${last_output_library})
        string(JSON output_library_name GET "${manifest_contents}"
          dependencies ${dependency_index} outputs libraries ${output_library_index} link_name)
        string(JSON output_library_linkage GET "${manifest_contents}"
          dependencies ${dependency_index} outputs libraries ${output_library_index} linkage)
        string(JSON output_library_soname_type TYPE "${manifest_contents}"
          dependencies ${dependency_index} outputs libraries ${output_library_index} soname)
        if(output_library_soname_type STREQUAL "NULL")
          set(output_library_soname "-")
        else()
          string(JSON output_library_soname GET "${manifest_contents}"
            dependencies ${dependency_index} outputs libraries ${output_library_index} soname)
        endif()
        list(APPEND output_library_names "${output_library_name}")
        list(APPEND output_library_linkages "${output_library_linkage}")
        list(APPEND output_library_sonames "${output_library_soname}")
      endforeach()
    endif()
    set("CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_HEADERS"
      "${output_headers}" PARENT_SCOPE)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_LIBRARIES"
      "${output_library_names}" PARENT_SCOPE)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_LINKAGES"
      "${output_library_linkages}" PARENT_SCOPE)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_SONAMES"
      "${output_library_sonames}" PARENT_SCOPE)

    set(license_sources "")
    set(license_destinations "")
    set(license_sha256s "")
    string(JSON license_count LENGTH "${manifest_contents}" dependencies ${dependency_index} licenses)
    math(EXPR last_license "${license_count} - 1")
    foreach(license_index RANGE 0 ${last_license})
      foreach(license_key IN ITEMS source destination sha256)
        string(JSON license_value GET "${manifest_contents}"
          dependencies ${dependency_index} licenses ${license_index} ${license_key})
        if(license_key STREQUAL "source")
          list(APPEND license_sources "${license_value}")
        elseif(license_key STREQUAL "destination")
          list(APPEND license_destinations "${license_value}")
        else()
          list(APPEND license_sha256s "${license_value}")
        endif()
      endforeach()
    endforeach()
    set("CUBRID_3RDPARTY_${dependency_variable_name}_LICENSE_SOURCES"
      "${license_sources}" PARENT_SCOPE)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_LICENSE_DESTINATIONS"
      "${license_destinations}" PARENT_SCOPE)
    set("CUBRID_3RDPARTY_${dependency_variable_name}_LICENSE_SHA256S"
      "${license_sha256s}" PARENT_SCOPE)
  endforeach()

  set(CUBRID_3RDPARTY_DEPENDENCIES "${dependency_names}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_MANIFEST "${manifest_path}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_MANIFEST_JSON "${manifest_contents}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_PLATFORM_ARCHITECTURE "${platform_architecture}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_PLATFORM_OS "${platform_os}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_PLATFORM_VARIANT "${platform_variant}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_RECIPE_REVISION "${recipe_revision}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_SCHEMA "${schema}" PARENT_SCOPE)
  set(CUBRID_3RDPARTY_SPEC_FINGERPRINT "${manifest_fingerprint}" PARENT_SCOPE)
endfunction()

function(cubrid_thirdparty_manifest_get output_variable)
  if(NOT DEFINED CUBRID_3RDPARTY_MANIFEST_JSON)
    _cubrid_thirdparty_fail("load the manifest before querying it")
  endif()
  string(JSON manifest_value ERROR_VARIABLE json_error
    GET "${CUBRID_3RDPARTY_MANIFEST_JSON}" ${ARGN})
  if(json_error)
    _cubrid_thirdparty_fail("manifest query '${ARGN}' failed: ${json_error}")
  endif()
  set(${output_variable} "${manifest_value}" PARENT_SCOPE)
endfunction()

function(cubrid_thirdparty_expand_arguments dependency field prefix output_variable)
  string(TOUPPER "${dependency}" dependency_variable_name)
  string(TOUPPER "${field}" field_variable_name)
  set(source_variable "CUBRID_3RDPARTY_${dependency_variable_name}_${field_variable_name}_ARGUMENTS")
  set(expanded_arguments "")
  foreach(argument IN LISTS ${source_variable})
    string(REPLACE "<PREFIX>" "${prefix}" argument "${argument}")
    list(APPEND expanded_arguments "${argument}")
  endforeach()
  set(${output_variable} "${expanded_arguments}" PARENT_SCOPE)
endfunction()

function(cubrid_thirdparty_require_recipe dependency expected_recipe)
  string(TOUPPER "${dependency}" dependency_variable_name)
  set(recipe_variable "CUBRID_3RDPARTY_${dependency_variable_name}_RECIPE")
  if(NOT "${${recipe_variable}}" STREQUAL "${expected_recipe}")
    _cubrid_thirdparty_fail(
      "${dependency} recipe drift: manifest='${${recipe_variable}}', ExternalProject='${expected_recipe}'")
  endif()
endfunction()

function(cubrid_thirdparty_require_outputs dependency)
  cmake_parse_arguments(CONTRACT "" "" "HEADERS;LIBRARIES;LINKAGES;SONAMES" ${ARGN})
  string(TOUPPER "${dependency}" dependency_variable_name)
  foreach(output_kind IN ITEMS HEADERS LIBRARIES LINKAGES SONAMES)
    set(manifest_variable "CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_${output_kind}")
    if(NOT "${${manifest_variable}}" STREQUAL "${CONTRACT_${output_kind}}")
      string(TOLOWER "${output_kind}" readable_output_kind)
      _cubrid_thirdparty_fail("${dependency} ${readable_output_kind} drift: "
        "manifest='${${manifest_variable}}', ExternalProject='${CONTRACT_${output_kind}}'")
    endif()
  endforeach()
endfunction()

function(cubrid_thirdparty_expand_environment dependency environment_name prefix output_variable)
  string(TOUPPER "${dependency}" dependency_variable_name)
  set(source_variable "CUBRID_3RDPARTY_${dependency_variable_name}_ENV_${environment_name}")
  set(environment_value "${${source_variable}}")
  string(REPLACE "<PREFIX>" "${prefix}" environment_value "${environment_value}")
  set(${output_variable} "${environment_value}" PARENT_SCOPE)
endfunction()

function(cubrid_thirdparty_select_mode output_variable)
  set(cache_mode "")
  if(DEFINED CUBRID_3RDPARTY_MODE)
    set(cache_mode "${CUBRID_3RDPARTY_MODE}")
  endif()
  set(environment_mode "$ENV{CUBRID_3RDPARTY_MODE}")
  if(NOT cache_mode STREQUAL "" AND NOT environment_mode STREQUAL ""
      AND NOT cache_mode STREQUAL environment_mode)
    _cubrid_thirdparty_fail(
      "CUBRID_3RDPARTY_MODE differs between CMake ('${cache_mode}') and environment ('${environment_mode}')")
  endif()
  if(NOT cache_mode STREQUAL "")
    set(selected_mode "${cache_mode}")
  elseif(NOT environment_mode STREQUAL "")
    set(selected_mode "${environment_mode}")
  else()
    set(selected_mode "EXTERNAL")
  endif()
  if(NOT selected_mode MATCHES "^(EXTERNAL|CI_PREBUILT)$")
    _cubrid_thirdparty_fail("unsupported CUBRID_3RDPARTY_MODE: ${selected_mode}")
  endif()
  if(cache_mode STREQUAL "" AND environment_mode STREQUAL ""
      AND (DEFINED CUBRID_3RDPARTY_ROOT OR NOT "$ENV{CUBRID_3RDPARTY_ROOT}" STREQUAL ""))
    _cubrid_thirdparty_fail("CUBRID_3RDPARTY_ROOT is set while CUBRID_3RDPARTY_MODE is unset")
  endif()
  set(CUBRID_3RDPARTY_MODE "${selected_mode}" PARENT_SCOPE)
  set(${output_variable} "${selected_mode}" PARENT_SCOPE)
endfunction()

macro(cubrid_thirdparty_export_variables)
  foreach(contract_variable IN ITEMS
      EP_TARGETS EP_LIBS EP_INCLUDES
      TBB_TARGETS TBB_LIBS TBB_INCLUDES
      LIBEDIT_TARGET LIBEDIT_LIBS LIBEDIT_INCLUDES
      LIBEXPAT_TARGET LIBEXPAT_LIBS LIBEXPAT_INCLUDES
      LZ4_TARGET LZ4_LIBS LZ4_INCLUDES
      LIBOPENSSL_TARGET LIBOPENSSL_LIBS LIBOPENSSL_INCLUDES
      LIBUNIXODBC_TARGET LIBUNIXODBC_LIBS LIBUNIXODBC_INCLUDES
      RAPIDJSON_TARGET RAPIDJSON_LIBS RAPIDJSON_INCLUDES
      RE2_TARGET RE2_LIBS RE2_INCLUDES
      LIBTBB_TARGET LIBTBB_LIBS LIBTBB_INCLUDES)
    set(${contract_variable} "${${contract_variable}}" PARENT_SCOPE)
  endforeach()
endmacro()

function(cubrid_thirdparty_add_prefix_target)
  cmake_parse_arguments(PRODUCER "" "SOURCE_ROOT;BINARY_ROOT" "DEPENDENCY_TARGETS" ${ARGN})
  if(PRODUCER_UNPARSED_ARGUMENTS)
    _cubrid_thirdparty_fail("unknown producer arguments: ${PRODUCER_UNPARSED_ARGUMENTS}")
  endif()
  foreach(required_argument IN ITEMS SOURCE_ROOT BINARY_ROOT)
    if(NOT PRODUCER_${required_argument})
      _cubrid_thirdparty_fail("producer ${required_argument} is required")
    endif()
  endforeach()
  if(NOT DEFINED CUBRID_3RDPARTY_PREFIX_OUTPUT OR CUBRID_3RDPARTY_PREFIX_OUTPUT STREQUAL "")
    _cubrid_thirdparty_fail("CUBRID_3RDPARTY_PREFIX_OUTPUT is required")
  endif()
  if(NOT IS_ABSOLUTE "${CUBRID_3RDPARTY_PREFIX_OUTPUT}")
    _cubrid_thirdparty_fail("CUBRID_3RDPARTY_PREFIX_OUTPUT must be absolute")
  endif()

  file(REAL_PATH "${CUBRID_3RDPARTY_PREFIX_OUTPUT}" PRODUCER_OUTPUT)
  file(REAL_PATH "${PRODUCER_SOURCE_ROOT}" PRODUCER_SOURCE_ROOT)
  file(REAL_PATH "${PRODUCER_BINARY_ROOT}" PRODUCER_BINARY_ROOT)
  if(PRODUCER_OUTPUT STREQUAL "/")
    _cubrid_thirdparty_fail("CUBRID_3RDPARTY_PREFIX_OUTPUT must not be the filesystem root")
  endif()
  foreach(project_root IN ITEMS "${PRODUCER_SOURCE_ROOT}" "${PRODUCER_BINARY_ROOT}")
    file(RELATIVE_PATH root_from_output "${PRODUCER_OUTPUT}" "${project_root}")
    if(root_from_output STREQUAL "" OR NOT root_from_output MATCHES "^\\.\\.(/|$)")
      _cubrid_thirdparty_fail(
        "CUBRID_3RDPARTY_PREFIX_OUTPUT must not be a project root or its ancestor: ${PRODUCER_OUTPUT}")
    endif()
  endforeach()

  if(NOT "${PRODUCER_DEPENDENCY_TARGETS}" STREQUAL "")
    list(LENGTH PRODUCER_DEPENDENCY_TARGETS dependency_target_count)
  else()
    set(dependency_target_count 0)
  endif()
  list(LENGTH CUBRID_3RDPARTY_DEPENDENCIES dependency_count)
  if(NOT dependency_target_count EQUAL dependency_count)
    _cubrid_thirdparty_fail(
      "producer requires one dependency target for each manifest dependency")
  endif()
  foreach(dependency_target IN LISTS PRODUCER_DEPENDENCY_TARGETS)
    if(NOT TARGET "${dependency_target}")
      _cubrid_thirdparty_fail("producer dependency target does not exist: ${dependency_target}")
    endif()
  endforeach()

  set(PRODUCER_ARTIFACTS_JSON "[]")
  set(producer_artifact_count 0)
  foreach(dependency IN LISTS CUBRID_3RDPARTY_DEPENDENCIES)
    string(TOUPPER "${dependency}" dependency_variable_name)
    foreach(artifact_kind IN ITEMS HEADERS LIBRARIES)
      set(output_variable "CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_${artifact_kind}")
      set(input_variable "CUBRID_3RDPARTY_${dependency_variable_name}_INPUT_${artifact_kind}")
      list(LENGTH ${output_variable} output_count)
      list(LENGTH ${input_variable} input_count)
      if(NOT input_count EQUAL output_count)
        _cubrid_thirdparty_fail(
          "${dependency} producer ${artifact_kind} inputs (${input_count}) do not match "
          "manifest outputs (${output_count})")
      endif()
      if(output_count GREATER 0)
        math(EXPR last_output "${output_count} - 1")
        foreach(output_index RANGE 0 ${last_output})
          list(GET ${input_variable} ${output_index} input_path)
          list(GET ${output_variable} ${output_index} output_path)
          if(artifact_kind STREQUAL "LIBRARIES")
            set(linkage_variable "CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_LINKAGES")
            set(soname_variable "CUBRID_3RDPARTY_${dependency_variable_name}_OUTPUT_SONAMES")
            list(GET ${linkage_variable} ${output_index} linkage)
            list(GET ${soname_variable} ${output_index} soname)
          else()
            set(linkage "-")
            set(soname "-")
          endif()
          set(artifact_json "{}")
          foreach(artifact_field IN ITEMS kind source destination linkage soname)
            if(artifact_field STREQUAL "kind")
              set(artifact_value "${artifact_kind}")
            elseif(artifact_field STREQUAL "source")
              set(artifact_value "${input_path}")
            elseif(artifact_field STREQUAL "destination")
              set(artifact_value "${output_path}")
            else()
              set(artifact_value "${${artifact_field}}")
            endif()
            _cubrid_thirdparty_quote_json("${artifact_value}" artifact_value_json)
            string(JSON artifact_json SET "${artifact_json}"
              "${artifact_field}" "${artifact_value_json}")
          endforeach()
          string(JSON PRODUCER_ARTIFACTS_JSON SET "${PRODUCER_ARTIFACTS_JSON}"
            ${producer_artifact_count} "${artifact_json}")
          math(EXPR producer_artifact_count "${producer_artifact_count} + 1")
        endforeach()
      endif()
    endforeach()
  endforeach()

  get_filename_component(manifest_directory "${CUBRID_3RDPARTY_MANIFEST}" DIRECTORY)
  get_filename_component(PRODUCER_REPOSITORY_ROOT "${manifest_directory}/.." ABSOLUTE)
  find_program(PRODUCER_READELF_EXECUTABLE NAMES readelf REQUIRED)
  set(PRODUCER_MANIFEST "${CUBRID_3RDPARTY_MANIFEST}")
  set(PRODUCER_CONTRACT_MODULE "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(PRODUCER_CMAKE_VERSION "${CMAKE_VERSION}")
  set(PRODUCER_GENERATOR "${CMAKE_GENERATOR}")
  set(PRODUCER_COMPILER_ID "${CMAKE_C_COMPILER_ID}")
  set(PRODUCER_COMPILER_PATH "${CMAKE_C_COMPILER}")
  set(PRODUCER_COMPILER_VERSION "${CMAKE_C_COMPILER_VERSION}")
  execute_process(
    COMMAND "${CMAKE_C_COMPILER}" -dumpmachine
    RESULT_VARIABLE compiler_target_status
    OUTPUT_VARIABLE PRODUCER_COMPILER_TARGET
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT compiler_target_status EQUAL 0 OR PRODUCER_COMPILER_TARGET STREQUAL "")
    set(PRODUCER_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")
  endif()
  if(PRODUCER_COMPILER_TARGET STREQUAL "")
    set(PRODUCER_COMPILER_TARGET "unknown")
  endif()
  set(PRODUCER_OBSERVED_OS "${CMAKE_SYSTEM_NAME}")
  string(TOLOWER "${PRODUCER_OBSERVED_OS}" PRODUCER_OBSERVED_OS)
  set(PRODUCER_OBSERVED_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")

  set(producer_config "${CMAKE_CURRENT_BINARY_DIR}/cubrid-thirdparty-producer-config.cmake")
  configure_file(
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CubridThirdPartyProducerConfig.cmake.in"
    "${producer_config}" @ONLY)
  add_custom_target(cubrid_thirdparty_prefix
    COMMAND "${CMAKE_COMMAND}" "-DPRODUCER_CONFIG=${producer_config}"
      -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CubridThirdPartyProducer.cmake"
    DEPENDS ${PRODUCER_DEPENDENCY_TARGETS}
    COMMENT "Publishing relocatable CUBRID third-party prefix at ${PRODUCER_OUTPUT}"
    VERBATIM)
endfunction()
