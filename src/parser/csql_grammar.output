  1447               | HOUR_SECOND
  1448               | HOUR_MINUTE
  1449               | DAY_MILLISECOND
  1450               | DAY_SECOND
  1451               | DAY_MINUTE
  1452               | DAY_HOUR
  1453               | YEAR_MONTH

  1454 opt_on_target: %empty
  1455              | ON_ primary

  1456 generic_function: identifier '(' opt_expression_list ')' opt_on_target

  1457 generic_function_id: generic_function

  1458 opt_expression_list: %empty
  1459                    | expression_list

  1460 table_set_function_call: SET subquery
  1461                        | SEQUENCE subquery
  1462                        | LIST subquery
  1463                        | MULTISET subquery

  1464 search_condition: search_condition OR boolean_term_xor
  1465                 | boolean_term_xor

  1466 boolean_term_xor: boolean_term_xor XOR boolean_term_is
  1467                 | boolean_term_is

  1468 boolean_term_is: boolean_term_is is_op boolean
  1469                | boolean_term

  1470 is_op: IS NOT
  1471      | IS

  1472 boolean_term: boolean_term AND boolean_factor
  1473             | boolean_factor

  1474 boolean_factor: NOT predicate
  1475               | '!' predicate
  1476               | predicate

  1477 predicate: EXISTS expression_
  1478          | expression_

  1479 $@258: %empty

  1480 predicate_expression: predicate_expr_sub $@258 opt_paren_plus

  1481 predicate_expr_sub: pred_lhs comp_op normal_expression
  1482                   | pred_lhs like_op normal_expression ESCAPE escape_literal
  1483                   | pred_lhs like_op normal_expression
  1484                   | pred_lhs rlike_op normal_expression
  1485                   | pred_lhs null_op
  1486                   | pred_lhs set_op normal_expression
  1487                   | pred_lhs between_op normal_expression AND normal_expression
  1488                   | pred_lhs in_op in_pred_operand
  1489                   | pred_lhs RANGE_ '(' range_list ')'
  1490                   | pred_lhs IdName

  1491 pred_lhs: normal_expression opt_paren_plus

  1492 opt_paren_plus: %empty
  1493               | paren_plus

  1494 comp_op: '=' opt_of_all_some_any
  1495        | COMP_NOT_EQ opt_of_all_some_any
  1496        | '>' opt_of_all_some_any
  1497        | COMP_GE opt_of_all_some_any
  1498        | '<' opt_of_all_some_any
  1499        | COMP_LE opt_of_all_some_any
  1500        | '=' '=' opt_of_all_some_any
  1501        | '!' '=' opt_of_all_some_any
  1502        | COMP_NULLSAFE_EQ opt_of_all_some_any

  1503 opt_of_all_some_any: %empty
  1504                    | ALL
  1505                    | SOME
  1506                    | ANY

  1507 like_op: NOT LIKE
  1508        | LIKE

  1509 rlike_op: rlike_or_regexp
  1510         | NOT rlike_or_regexp
  1511         | rlike_or_regexp BINARY
  1512         | NOT rlike_or_regexp BINARY

  1513 rlike_or_regexp: RLIKE
  1514                | REGEXP

  1515 null_op: IS NOT Null
  1516        | IS Null

  1517 between_op: NOT BETWEEN
  1518           | BETWEEN

  1519 in_op: IN_
  1520      | NOT IN_

  1521 in_pred_operand: expression_

  1522 range_list: range_list OR range_
  1523           | range_

  1524 range_: expression_ GE_LE_ expression_
  1525       | expression_ GE_LT_ expression_
  1526       | expression_ GT_LE_ expression_
  1527       | expression_ GT_LT_ expression_
  1528       | expression_ '='
  1529       | expression_ GE_INF_ Max
  1530       | expression_ GT_INF_ Max
  1531       | Min INF_LE_ expression_
  1532       | Min INF_LT_ expression_

  1533 set_op: SETEQ
  1534       | SETNEQ
  1535       | SUBSET
  1536       | SUBSETEQ
  1537       | SUPERSETEQ
  1538       | SUPERSET

  1539 subquery: '(' csql_query ')'

