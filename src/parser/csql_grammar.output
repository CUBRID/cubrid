State 0

    0 $accept: . stmt_done $end
    1 stmt_done: . stmt_list
    2          | . %empty  [$end]
    3 stmt_list: . stmt_list stmt
    4          | . stmt
    5 $@1: . %empty  [ALTER, ATTACH, CALL, COMMIT, CREATE, DATA_TYPE_, DEALLOCATE, DELETE_, DESC, DESCRIBE, DO, DROP, EVALUATE, EXECUTE, GET, GRANT, INSERT, MERGE, PREPARE, RENAME, REPLACE, REVOKE, ROLLBACK, SAVEPOINT, SCOPE, SELECT, SET, TRUNCATE, UPDATE, VACUUM, VALUE, VALUES, WITH, EXPLAIN, KILL, SHOW, '(']
    8 stmt: . $@1 $@2 stmt_ $@3
    9     | . ';'

    ';'  shift, and go to state 1

    $end      reduce using rule 2 (stmt_done)
    $default  reduce using rule 5 ($@1)

    stmt_done  go to state 2
    stmt_list  go to state 3
    stmt       go to state 4
    $@1        go to state 5


State 1

    9 stmt: ';' .

    $default  reduce using rule 9 (stmt)


State 2

    0 $accept: stmt_done . $end

    $end  shift, and go to state 6


State 3

    1 stmt_done: stmt_list .  [$end]
    3 stmt_list: stmt_list . stmt
    5 $@1: . %empty  [ALTER, ATTACH, CALL, COMMIT, CREATE, DATA_TYPE_, DEALLOCATE, DELETE_, DESC, DESCRIBE, DO, DROP, EVALUATE, EXECUTE, GET, GRANT, INSERT, MERGE, PREPARE, RENAME, REPLACE, REVOKE, ROLLBACK, SAVEPOINT, SCOPE, SELECT, SET, TRUNCATE, UPDATE, VACUUM, VALUE, VALUES, WITH, EXPLAIN, KILL, SHOW, '(']
    8 stmt: . $@1 $@2 stmt_ $@3
    9     | . ';'

    ';'  shift, and go to state 1

    $end      reduce using rule 1 (stmt_done)
    $default  reduce using rule 5 ($@1)

    stmt  go to state 7
    $@1   go to state 5


State 4

    4 stmt_list: stmt .

    $default  reduce using rule 4 (stmt_list)


State 5

    6 $@2: . %empty
    8 stmt: $@1 . $@2 stmt_ $@3

    $default  reduce using rule 6 ($@2)

    $@2  go to state 8


State 6

    0 $accept: stmt_done $end .

    $default  accept


State 7

    3 stmt_list: stmt_list stmt .

    $default  reduce using rule 3 (stmt_list)


