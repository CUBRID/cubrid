set(package_version_file "@PROJECT_BINARY_DIR@/package-version.txt")
if(CPACK_INSTALL_CMAKE_PROJECTS AND NOT EXISTS "${package_version_file}")
  message(FATAL_ERROR "Build CUBRID before invoking CPack, or use the package target.")
endif()

execute_process(
  COMMAND sh "@PROJECT_SOURCE_DIR@/cmake/git-build-version.sh"
    "@GIT_EXECUTABLE@" "@PROJECT_SOURCE_DIR@" "${package_version_file}"
  OUTPUT_VARIABLE git_version OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)

if(CPACK_INSTALL_CMAKE_PROJECTS)
  file(STRINGS "${package_version_file}" package_version_fields)
  list(GET package_version_fields 0 built_git_version)
  list(GET package_version_fields 1 package_version)
  file(STRINGS "@PROJECT_BINARY_DIR@/build-version.txt" build_version_fields)
  if(NOT git_version STREQUAL built_git_version OR NOT build_version_fields STREQUAL package_version_fields)
    message(FATAL_ERROR "The CUBRID package is out of date. Build again before invoking CPack.")
  endif()
  # With Unix Makefiles CPack can invoke make preinstall after reading metadata.
  set(ENV{CUBRID_CPACK_GIT_VERSION} "${built_git_version}")
else()
  string(REPLACE " " ";" version_fields "${git_version}")
  list(GET version_fields 1 build_count)
  list(GET version_fields 2 short_revision)
  set(package_version "@MAJOR_RELEASE_STRING@.${build_count}-${short_revision}")
endif()

string(REPLACE "@CUBRID_VERSION@" "${package_version}" CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}")
set(CPACK_PACKAGE_VERSION "${package_version}")
