cmake_minimum_required(VERSION 3.21)

set(build_version_file "@PROJECT_BINARY_DIR@/build-version.txt")

execute_process(
  COMMAND sh "@PROJECT_SOURCE_DIR@/cmake/git-build-version.sh"
    "@GIT_EXECUTABLE@" "@PROJECT_SOURCE_DIR@" "${build_version_file}"
  OUTPUT_VARIABLE git_version OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE " " ";" version_fields "${git_version}")
list(GET version_fields 1 CUBRID_EXTRA_VERSION)
list(GET version_fields 2 short_revision)
set(BUILD_NUMBER "@MAJOR_RELEASE_STRING@.${CUBRID_EXTRA_VERSION}")
set(CUBRID_VERSION "${BUILD_NUMBER}-${short_revision}")
set(version_record "${git_version}\n${CUBRID_VERSION}\n")

if(CUBRID_UPDATE_BUILD_VERSION)
  if(DEFINED ENV{CUBRID_CPACK_GIT_VERSION} AND NOT "$ENV{CUBRID_CPACK_GIT_VERSION}" STREQUAL git_version)
    message(FATAL_ERROR "Git version changed during packaging. Build again before invoking CPack.")
  endif()
  configure_file("@PROJECT_SOURCE_DIR@/cmake/build_version.h.cmake" "@PROJECT_BINARY_DIR@/build_version.h" @ONLY)
  file(CONFIGURE OUTPUT "${build_version_file}" CONTENT "${version_record}" @ONLY)
  return()
endif()

if(CPACK_INSTALL_CMAKE_PROJECTS)
  set(package_version_file "@PROJECT_BINARY_DIR@/package-version.txt")
  if(NOT EXISTS "${package_version_file}")
    message(FATAL_ERROR "Build CUBRID before invoking CPack, or use the package target.")
  endif()
  file(READ "${build_version_file}" build_version)
  file(READ "${package_version_file}" package_version)
  if(NOT build_version STREQUAL version_record OR NOT package_version STREQUAL version_record)
    message(FATAL_ERROR "The CUBRID package is out of date. Build again before invoking CPack.")
  endif()
  # Unix Makefiles can run preinstall after CPack has read the package version.
  set(ENV{CUBRID_CPACK_GIT_VERSION} "${git_version}")
endif()

string(REPLACE "@CUBRID_VERSION@" "${CUBRID_VERSION}" CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}")
set(CPACK_PACKAGE_VERSION "${CUBRID_VERSION}")
