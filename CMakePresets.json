{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_preset_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{CUBRID}",
        "WITH_CCI": "true"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "description": "Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release_avx2",
      "inherits": "release",
      "cacheVariables": {
        "FAISS_SIMD_MODE": "AVX2"
      }
    },
    {
      "name": "release_avx512",
      "inherits": "release",
      "cacheVariables": {
        "FAISS_SIMD_MODE": "AVX512"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "description": "Debug build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug_avx2",
      "inherits": "debug",
      "cacheVariables": {
        "FAISS_SIMD_MODE": "AVX2"
      }
    },
    {
      "name": "debug_avx512",
      "inherits": "debug",
      "cacheVariables": {
        "FAISS_SIMD_MODE": "AVX512"
      }
    },
    {
      "name": "coverage",
      "inherits": "default",
      "description": "Coverage build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Coverage"
      }
    },
    {
      "name": "profile",
      "inherits": "default",
      "description": "Profile build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Profile"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "hidden": true,
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release_avx2",
      "configurePreset": "release_avx2"
    },
    {
      "name": "release_avx512",
      "configurePreset": "release_avx512"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug_avx2",
      "configurePreset": "debug_avx2"
    },
    {
      "name": "debug_avx512",
      "configurePreset": "debug_avx512"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    }
  ]
}
