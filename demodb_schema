CREATE OR REPLACE PROCEDURE [dba].[t]([in_value] IN integer, [out_value] OUT character varying) AUTHID OWNER AS
cursor my_cursor(a int) IS SELECT name FROM tbl WHERE id = a;
            target_name char(10);
        begin
            open my_cursor(in_value);
            loop
                fetch my_cursor into target_name;
                exit when my_cursor%NOTFOUND;
                dbms_output.put_line('id: ' || in_value || ' name: ' || target_name);
                out_value := target_name;
            end loop;
            close my_cursor;
        end
         COMMENT 'this is comment';

