#include <assert.h>
#include <setjmp.h>
#include <stdio.h>
#include <string.h>
#include <stdbool.h>
typedef int THREAD_ENTRY;
typedef struct
{
  int occupied, logged;
} Page;
typedef struct
{
  int slotid;
} Oid;
typedef struct
{
  int can_vacuum, record_type, reusable, crt_slotid, n_bulk_vacuumed, n_vacuumed;
  int mvcc_header, hfid, overflow_vfid, forward_recdes, record, slots[2], results[2];
  Oid forward_oid;
  Page *home_page, *forward_page;
} VACUUM_HEAP_HELPER;
enum
{
  VACUUM_RECORD_REMOVE = 1,
  REC_RELOCATION = 2,
  REC_BIGONE = 3,
  REC_HOME = 4,
  FREE = 1,
  DONT_FREE = 0,
  NO_ERROR = 0,
  ER_FAILED = -1,
  PSTAT_HEAP_REMOVE_VACUUMS,
  PSTAT_HEAP_REL_VACUUMS,
  PSTAT_HEAP_BIG_VACUUMS,
  PSTAT_HEAP_HOME_VACUUMS
};
#define MVCC_IS_HEADER_DELID_VALID(x) (1)
#define OID_ISNULL(x) (0)
#define HFID_IS_NULL(x) (0)
#define VFID_ISNULL(x) (0)
#define VACUUM_PERF_HEAP_TRACK_EXECUTE(...) ((void)0)
#define VACUUM_PERF_HEAP_TRACK_LOGGING(...) ((void)0)
#define assert_release(x) assert(x)
static Page *target;
static int injected, syscommitted;
static jmp_buf crashed;
static void
vacuum_heap_page_log_and_reset (THREAD_ENTRY * t, VACUUM_HEAP_HELPER * h, bool a, bool b)
{
  (void) t;
  (void) h;
  (void) a;
  (void) b;
}

static void
log_sysop_start (THREAD_ENTRY * t)
{
  (void) t;
}

static void
log_sysop_commit (THREAD_ENTRY * t)
{
  (void) t;
  syscommitted = 1;
}

static void
log_sysop_abort (THREAD_ENTRY * t)
{
  (void) t;
}

static void
spage_vacuum_slot (THREAD_ENTRY * t, Page * p, int slot, bool reuse)
{
  (void) t;
  (void) slot;
  (void) reuse;
  p->occupied = 0;
}

static void
perfmon_inc_stat (THREAD_ENTRY * t, int stat)
{
  (void) t;
  (void) stat;
}

static void
pgbuf_set_dirty (THREAD_ENTRY * t, Page * p, int release)
{
  (void) t;
  if (p == target && release && !syscommitted)
    {
      assert (!p->occupied);
      p->occupied = 1;
      injected = 1;
      if (p->logged)
        longjmp (crashed, 1);
    }
}

static void
vacuum_log_redoundo_vacuum_record (THREAD_ENTRY * t, Page * p, int slot, int *record, bool reuse)
{
  (void) t;
  (void) slot;
  (void) record;
  (void) reuse;
  p->logged = 1;
  if (p == target && injected)
    longjmp (crashed, 1);
}

static void
heap_add_bestpage (THREAD_ENTRY * t, int *h, Page * p)
{
  (void) t;
  (void) h;
  (void) p;
}

static void
pgbuf_unfix_and_init (THREAD_ENTRY * t, Page * p)
{
  (void) t;
  (void) p;
}

static void *
heap_ovf_delete (THREAD_ENTRY * t, int *h, Oid * o, int *v)
{
  (void) t;
  (void) h;
  (void) o;
  (void) v;
  return (void *) 1;
}

/* EXTRACTED_FUNCTION */
int
main (int argc, char **argv)
{
  static Page home = { 1, 0 };
  static Page forward = { 1, 0 };
  THREAD_ENTRY thread = 0;
  VACUUM_HEAP_HELPER helper = { 0 };
  if (argc != 2)
    return 2;
  target = strcmp (argv[1], "home") == 0 ? &home : &forward;
  helper.home_page = &home;
  helper.forward_page = &forward;
  helper.reusable = 1;
  helper.can_vacuum = VACUUM_RECORD_REMOVE;
  helper.record_type = REC_RELOCATION;
  if (setjmp (crashed) == 0)
    {
      if (vacuum_heap_record (&thread, &helper) != NO_ERROR)
        return 2;
      puts ("NO INJECTION");
      return 0;
    }
  assert (injected && target->logged && target->occupied && !syscommitted);
  puts ("MOCK REPLAY: committed competing insert occupies the undo slot");
  return 1;
}
